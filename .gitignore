#!/usr/bin/env python3
"""
NewLang — minimal interpreter

Usage:
  python3 main.py program.tl
"""

import sys
import re

# ---------------------
# Lexer
# ---------------------
TOKEN_SPEC = [
    ('NUMBER',   r'\d+(\.\d+)?'),
    ('ID',       r'[A-Za-z_][A-Za-z0-9_]*'),
    ('OP',       r'==|!=|<=|>=|[+\-*/<>!]'),
    ('ASSIGN',   r'='),
    ('LPAREN',   r'\('),
    ('RPAREN',   r'\)'),
    ('LBRACE',   r'\{'),
    ('RBRACE',   r'\}'),
    ('SEMICOLON',r';'),
    ('COMMA',    r','),
    ('SKIP',     r'[ \t]+'),
    ('NEWLINE',  r'\n'),
    ('COMMENT',  r'#.*'),
]
TOKEN_RE = re.compile('|'.join('(?P<%s>%s)' % pair for pair in TOKEN_SPEC))

KEYWORDS = {'let','if','else','while','print','true','false','null'}

class Token:
    def __init__(self, type_, value, pos):
        self.type = type_
        self.value = value
        self.pos = pos
    def __repr__(self):
        return f'Token({self.type},{self.value})'

def lex(code):
    pos = 0
    line = 1
    tokens = []
    for m in TOKEN_RE.finditer(code):
        kind = m.lastgroup
        value = m.group()
        if kind == 'NUMBER':
            if '.' in value:
                value = float(value)
            else:
                value = int(value)
            tokens.append(Token('NUMBER', value, pos))
        elif kind == 'ID':
            if value in KEYWORDS:
                tokens.append(Token(value.upper(), value, pos))
            else:
                tokens.append(Token('ID', value, pos))
        elif kind == 'SKIP' or kind == 'COMMENT':
            pass
        elif kind == 'NEWLINE':
            tokens.append(Token('NEWLINE', '\\n', pos))
            line += 1
        else:
            tokens.append(Token(kind, value, pos))
        pos = m.end()
    tokens.append(Token('EOF', None, pos))
    return tokens

# ---------------------
# Parser (recursive descent)
# ---------------------
class ParseError(Exception): pass

class Parser:
    def __init__(self, tokens):
        self.tokens = [t for t in tokens if t.type != 'NEWLINE']
        self.pos = 0

    def peek(self):
        return self.tokens[self.pos]

    def consume(self, expected_type=None):
        t = self.peek()
        if expected_type and t.type != expected_type:
            raise ParseError(f'Expected {expected_type} but got {t.type}')
        self.pos += 1
        return t

    def match(self, *types):
        if self.peek().type in types:
            return self.consume()
        return None

    def parse(self):
        stmts = []
        while self.peek().type != 'EOF':
            stmts.append(self.statement())
        return Program(stmts)

    # statements
    def statement(self):
        t = self.peek()
        if t.type == 'LET':
            return self.let_stmt()
        elif t.type == 'LBRACE':
            return self.block_stmt()
        elif t.type == 'IF':
            return self.if_stmt()
        elif t.type == 'WHILE':
            return self.while_stmt()
        elif t.type == 'PRINT':
            return self.print_stmt()
        elif t.type == 'ID':
            # assignment or expression statement
            # lookahead for '='
            if self.tokens[self.pos+1].type == 'ASSIGN':
                return self.assign_stmt()
            else:
                expr = self.expr()
                self.consume('SEMICOLON')
                return ExprStmt(expr)
        else:
            expr = self.expr()
            self.consume('SEMICOLON')
            return ExprStmt(expr)

    def let_stmt(self):
        self.consume('LET')
        name = self.consume('ID').value
        self.consume('ASSIGN')
        value = self.expr()
        self.consume('SEMICOLON')
        return LetStmt(name, value)

    def assign_stmt(self):
        name = self.consume('ID').value
        self.consume('ASSIGN')
        value = self.expr()
        self.consume('SEMICOLON')
        return AssignStmt(name, value)

    def print_stmt(self):
        self.consume('PRINT')
        self.consume('LPAREN')
        expr = self.expr()
        self.consume('RPAREN')
        self.consume('SEMICOLON')
        return PrintStmt(expr)

    def block_stmt(self):
        self.consume('LBRACE')
        stmts = []
        while self.peek().type != 'RBRACE':
            if self.peek().type == 'EOF':
                raise ParseError('Unexpected EOF in block')
            stmts.append(self.statement())
        self.consume('RBRACE')
        return BlockStmt(stmts)

    def if_stmt(self):
        self.consume('IF')
        self.consume('LPAREN')
        cond = self.expr()
        self.consume('RPAREN')
        then_block = self.block_stmt()
        else_block = None
        if self.peek().type == 'ELSE':
            self.consume('ELSE')
            else_block = self.block_stmt()
        return IfStmt(cond, then_block, else_block)

    def while_stmt(self):
        self.consume('WHILE')
        self.consume('LPAREN')
        cond = self.expr()
        self.consume('RPAREN')
        body = self.block_stmt()
        return WhileStmt(cond, body)

    # expressions with precedence
    def expr(self):
        return self.equality()

    def equality(self):
        node = self.comparison()
        while self.peek().type == 'OP' and self.peek().value in ('==','!='):
            op = self.consume().value
            right = self.comparison()
            node = BinaryOp(node, op, right)
        return node

    def comparison(self):
        node = self.term()
        while self.peek().type == 'OP' and self.peek().value in ('<','>','<=','>='):
            op = self.consume().value
            right = self.term()
            node = BinaryOp(node, op, right)
        return node

    def term(self):
        node = self.factor()
        while self.peek().type == 'OP' and self.peek().value in ('+','-'):
            op = self.consume().value
            right = self.factor()
            node = BinaryOp(node, op, right)
        return node

    def factor(self):
        node = self.unary()
        while self.peek().type == 'OP' and self.peek().value in ('*','/'):
            op = self.consume().value
            right = self.unary()
            node = BinaryOp(node, op, right)
        return node

    def unary(self):
        if self.peek().type == 'OP' and self.peek().value in ('-','!'):
            op = self.consume().value
            operand = self.unary()
            return UnaryOp(op, operand)
        return self.primary()

    def primary(self):
        t = self.peek()
        if t.type == 'NUMBER':
            self.consume()
            return NumberLiteral(t.value)
        if t.type == 'TRUE':
            self.consume()
            return BoolLiteral(True)
        if t.type == 'FALSE':
            self.consume()
            return BoolLiteral(False)
        if t.type == 'ID':
            name = self.consume().value
            return VarRef(name)
        if t.type == 'LPAREN':
            self.consume()
            e = self.expr()
            self.consume('RPAREN')
            return e
        raise ParseError(f'Unexpected token {t.type} ({t.value})')

# ---------------------
# AST Nodes
# ---------------------
class Node: pass

class Program(Node):
    def __init__(self, stmts): self.stmts = stmts

class LetStmt(Node):
    def __init__(self, name, value): self.name = name; self.value = value

class AssignStmt(Node):
    def __init__(self, name, value): self.name = name; self.value = value

class PrintStmt(Node):
    def __init__(self, expr): self.expr = expr

class IfStmt(Node):
    def __init__(self, cond, then_block, else_block): self.cond = cond; self.then_block = then_block; self.else_block = else_block

class WhileStmt(Node):
    def __init__(self, cond, body): self.cond = cond; self.body = body

class BlockStmt(Node):
    def __init__(self, stmts): self.stmts = stmts

class ExprStmt(Node):
    def __init__(self, expr): self.expr = expr

class NumberLiteral(Node):
    def __init__(self, value): self.value = value

class BoolLiteral(Node):
    def __init__(self, value): self.value = value

class VarRef(Node):
    def __init__(self, name): self.name = name

class BinaryOp(Node):
    def __init__(self, left, op, right): self.left = left; self.op = op; self.right = right

class UnaryOp(Node):
    def __init__(self, op, operand): self.op = op; self.operand = operand

# ---------------------
# Interpreter
# ---------------------
class RuntimeError_(Exception): pass

class Environment:
    def __init__(self, parent=None):
        self.vars = {}
        self.parent = parent
    def get(self, name):
        if name in self.vars:
            return self.vars[name]
        if self.parent:
            return self.parent.get(name)
        raise RuntimeError_(f'Undefined variable: {name}')
    def set(self, name, value):
        if name in self.vars:
            self.vars[name] = value
        elif self.parent:
            self.parent.set(name, value)
        else:
            raise RuntimeError_(f'Undefined variable: {name}')
    def define(self, name, value):
        self.vars[name] = value

class Interpreter:
    def __init__(self):
        self.globals = Environment()
    def run(self, program):
        try:
            self.exec_block(program.stmts, self.globals)
        except RuntimeError_ as e:
            print("Runtime error:", e)

    def exec_block(self, stmts, env):
        prev = getattr(self, 'env', None)
        self.env = env
        for s in stmts:
            self.exec_stmt(s)
        self.env = prev

    def exec_stmt(self, stmt):
        if isinstance(stmt, LetStmt):
            val = self.eval_expr(stmt.value)
            self.env.define(stmt.name, val)
        elif isinstance(stmt, AssignStmt):
            val = self.eval_expr(stmt.value)
            self.env.set(stmt.name, val)
        elif isinstance(stmt, PrintStmt):
            val = self.eval_expr(stmt.expr)
            print(self.stringify(val))
        elif isinstance(stmt, IfStmt):
            cond = self.eval_expr(stmt.cond)
            if self.is_truthy(cond):
                self.exec_stmt(stmt.then_block)
            elif stmt.else_block:
                self.exec_stmt(stmt.else_block)
        elif isinstance(stmt, WhileStmt):
            while self.is_truthy(self.eval_expr(stmt.cond)):
                self.exec_stmt(stmt.body)
        elif isinstance(stmt, BlockStmt):
            child = Environment(parent=self.env)
            self.exec_block(stmt.stmts, child)
        elif isinstance(stmt, ExprStmt):
            self.eval_expr(stmt.expr)
        else:
            raise RuntimeError_(f'Unknown stmt {stmt}')

    def eval_expr(self, expr):
        if isinstance(expr, NumberLiteral):
            return expr.value
        if isinstance(expr, BoolLiteral):
            return expr.value
        if isinstance(expr, VarRef):
            return self.env.get(expr.name)
        if isinstance(expr, UnaryOp):
            val = self.eval_expr(expr.operand)
            if expr.op == '-':
                return -val
            if expr.op == '!':
                return not self.is_truthy(val)
            raise RuntimeError_(f'Unknown unary op {expr.op}')
        if isinstance(expr, BinaryOp):
            l = self.eval_expr(expr.left)
            r = self.eval_expr(expr.right)
            op = expr.op
            if op == '+': return l + r
            if op == '-': return l - r
            if op == '*': return l * r
            if op == '/': return l / r
            if op == '<': return l < r
            if op == '>': return l > r
            if op == '<=': return l <= r
            if op == '>=': return l >= r
            if op == '==': return l == r
            if op == '!=': return l != r
            raise RuntimeError_(f'Unknown binary op {op}')
        raise RuntimeError_(f'Unknown expr {expr}')

    def is_truthy(self, value):
        if value is None: return False
        if isinstance(value, bool): return value
        if isinstance(value, (int,float)): return value != 0
        return True

    def stringify(self, v):
        if v is None: return 'null'
        return str(v)

# ---------------------
# Main / CLI
# ---------------------
def repl():
    interp = Interpreter()
    print("MertLang REPL — type 'exit' to quit")
    while True:
        try:
            line = input('> ')
        except EOFError:
            break
        if line.strip() == 'exit': break
        try:
            tokens = lex(line + '\n')  # ensure EOF
            program = Parser(tokens).parse()
            interp.run(program)
        except Exception as e:
            print("Error:", e)

def run_file(path):
    with open(path, 'r') as f:
        code = f.read()
    tokens = lex(code)
    ast = Parser(tokens).parse()
    Interpreter().run(ast)

if __name__ == '__main__':
    if len(sys.argv) == 1:
        repl()
    else:
        run_file(sys.argv[1])
